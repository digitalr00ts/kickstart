---
extends: default
ignore-from-file:
  - .gitignore
  - .yamlignore
rules:
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
    min-spaces-inside-empty: 0
    max-spaces-inside-empty: 2
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 1
    min-spaces-inside-empty: 0
    max-spaces-inside-empty: 2
  comments:
    ignore:
      - .github/
  comments-indentation: disable
  document-end:
    present: false
  document-start:
    present: true
  empty-values: enable
  float-values:
    require-numeral-before-decimal: true
  indentation:
    spaces: 2
  line-length:
    max: 120
    allow-non-breakable-words: true
    allow-non-breakable-inline-mappings: true
    level: error
  octal-values: enable
  quoted-strings:
    quote-type: single
    required: only-when-needed
    allow-quoted-quotes: true
  truthy:
    check-keys: false
